<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SchoolManagementSystem.Views.StudentListPage"
             Title="Students">
    <Grid RowDefinitions="Auto, *">
        <Button Grid.Row="0" Text="Add New Student" Command="{Binding AddStudentCommand}" Margin="10" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Students}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5">
                        <VerticalStackLayout>
                            <Label Text="{Binding FullName}" FontAttributes="Bold" />
                            <Label Text="{Binding AdmissionNumber}" />
                            <Label Text="{Binding ClassName}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
