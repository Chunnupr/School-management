<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SchoolManagementSystem.Models"
             x:Class="SchoolManagementSystem.Views.ChatPanelView">
    <Grid RowDefinitions="*, Auto">
        <CollectionView Grid.Row="0" ItemsSource="{Binding Messages}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessage">
                    <Frame Padding="10" Margin="5,5,50,5" CornerRadius="10"
                           HorizontalOptions="{Binding Alignment}"
                           BackgroundColor="{Binding Background}">
                        <Label Text="{Binding Text}" TextColor="{Binding TextColor}" />
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Padding="10">
            <Entry Grid.Column="0" Placeholder="Ask something..." Text="{Binding NewMessageText}" />
            <Button Grid.Column="1" Text="Send" Command="{Binding SendMessageCommand}" />
        </Grid>
    </Grid>
</ContentView>
