<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SchoolManagementSystem.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SchoolManagementSystem"
    xmlns:views="clr-namespace:SchoolManagementSystem.Views"
    FlyoutBehavior="Locked">

    <Shell.FlyoutContent>
        <views:ChatPanelView BindingContext="{Binding ChatViewModel}" />
    </Shell.FlyoutContent>

    <TabBar>
        <ShellContent
            Title="Students"
            ContentTemplate="{DataTemplate views:StudentListPage}"
            Route="StudentListPage" />
        <ShellContent
            Title="Finance"
            ContentTemplate="{DataTemplate views:FinanceDashboardPage}"
            Route="FinanceDashboardPage" />
        <ShellContent
            Title="Admin"
            ContentTemplate="{DataTemplate views:AdminDashboardPage}"
            Route="AdminDashboardPage" />
    </TabBar>

</Shell>
